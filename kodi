        private void LoadKamarieret()
        {
            try
            {
                using (SqlConnection con =
                       DbConnection.GetConnection())
                {
                    con.Open();

                    string query = @"
                        SELECT
                            WaiterID,
                            Name,
                            Active
                        FROM Kamarierat
                        WHERE Active = 1
                        ORDER BY Name";

                    using (SqlDataAdapter adapter =
                           new SqlDataAdapter(query, con))
                    {
                        DataTable table =
                            new DataTable();

                        adapter.Fill(table);

                        dgvKamarieret.DataSource =
                            table;
                    }
                }

                if (dgvKamarieret.Columns["WaiterID"] != null)
                {
                    dgvKamarieret.Columns[
                        "WaiterID"
                    ].HeaderText = "ID";
                }

                if (dgvKamarieret.Columns["Name"] != null)
                {
                    dgvKamarieret.Columns[
                        "Name"
                    ].HeaderText = "Emri";
                }

                if (dgvKamarieret.Columns["Active"] != null)
                {
                    dgvKamarieret.Columns[
                        "Active"
                    ].HeaderText = "Aktiv";
                }

                dgvKamarieret.AutoSizeColumnsMode =
                    DataGridViewAutoSizeColumnsMode.Fill;

                dgvKamarieret.SelectionMode =
                    DataGridViewSelectionMode.FullRowSelect;

                dgvKamarieret.MultiSelect = false;
                dgvKamarieret.ReadOnly = true;
                dgvKamarieret.AllowUserToAddRows = false;
                dgvKamarieret.AllowUserToDeleteRows = false;
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Gabim gjatë ngarkimit të kamarierëve:\n\n" +
                    ex.Message,
                    "Gabim",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error
                );
            }
        }


