        private void WaiterPanel_Click(
            object sender,
            EventArgs e)
        {
            Panel panel = sender as Panel;

            if (panel == null)
                return;

            int clickedWaiterId = Convert.ToInt32(panel.Tag);
            string clickedWaiterName = "Kamarieri";

            // Merr emrin real nga databaza sipas ID-së, jo nga teksti dekorativ i kartës.
            try
            {
                using (SqlConnection connection = DbConnection.GetConnection())
                {
                    connection.Open();
                    using (SqlCommand cmd = new SqlCommand(
                        "SELECT Name FROM Kamarierat WHERE WaiterID = @id AND Active = 1", connection))
                    {
                        cmd.Parameters.Add("@id", SqlDbType.Int).Value = clickedWaiterId;
                        object result = cmd.ExecuteScalar();
                        if (result == null || result == DBNull.Value)
                        {
                            MessageBox.Show("Kamarieri nuk u gjet ose nuk është aktiv në databazë.", "Verifikim", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                            return;
                        }
                        clickedWaiterName = Convert.ToString(result);
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Gabim gjatë leximit të kamarierit nga databaza:\n" + ex.Message, "Gabim", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            // Kërkojmë ID-në e kamarierit para se të lejojmë hyrjen në porosi.
            if (!PromptForWaiterId(clickedWaiterId, clickedWaiterName))
                return;

            selectedWaiterId = clickedWaiterId;
            selectedWaiter = clickedWaiterName;

