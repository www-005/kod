            if (item.Quantity <= item.AlreadyPrintedQuantity)
            {
                MessageBox.Show(
                    "Kjo sasi është dërguar tashmë.\n\n" +
                    "Për të mos ndryshuar porosinë e dërguar, " +
                    "kjo sasi nuk mund të zvogëlohet këtu.",
                    "Kujdes",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Information
