        private List<PendingPrintItem> GetPendingPrintItems(int orderId)
        {
            List<PendingPrintItem> items = new List<PendingPrintItem>();

            using (SqlConnection con = DbConnection.GetConnection())
            {
                con.Open();

                string query = @"
                    SELECT
                        p.Name,
                        oi.UnitPrice,
                        (oi.Quantity - ISNULL(oi.PrintedQuantity, 0)) AS PendingQuantity,
                        ISNULL(oi.Comment, '') AS Comment,
                        p.Destination,
                        ISNULL(c.Name, '') AS CategoryName
                    FROM OrderItems oi
                    INNER JOIN Products p ON p.ProductID = oi.ProductID
                    LEFT JOIN Categories c ON c.CategoryID = p.CategoryID
                    WHERE oi.OrderID = @OrderID
                      AND oi.Quantity > ISNULL(oi.PrintedQuantity, 0)
                    ORDER BY p.Name";

                using (SqlCommand cmd = new SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue("@OrderID", orderId);

                    using (SqlDataReader reader = cmd.ExecuteReader())
                    {
                        while (reader.Read())
                        {
                            items.Add(new PendingPrintItem
                            {
                                ProductName = reader["Name"].ToString(),
                                UnitPrice = Convert.ToDecimal(reader["UnitPrice"]),
                                Quantity = Convert.ToInt32(reader["PendingQuantity"]),
                                Comment = Convert.ToString(reader["Comment"]),
                                Destination = reader["Destination"].ToString(),
                                CategoryName = reader["CategoryName"].ToString()
                            });
                        }
                    }
                }
            }

            return items;
        }

        // Grupet e printimit bazohen së pari në kategorinë e ushqimit,
        // jo vetëm në Destination. Kështu sallatat ndahen nga pjatat kryesore.
        private int GetPrintGroupOrder(PendingPrintItem item)
        {
            string category = (item.CategoryName ?? "").Trim().ToLowerInvariant();
            string product = (item.ProductName ?? "").Trim().ToLowerInvariant();
            string destination = (item.Destination ?? "").Trim();

            if (category.Contains("pije") || category.Contains("embelsir") ||
                string.Equals(destination, "Bar", StringComparison.OrdinalIgnoreCase))
                return 4; // SHANGT

            if (category.Contains("parahaj"))
                return 1; // I - Parahajet

            if (category.Contains("pica") || category.Contains("pizza") || product.StartsWith("pizza "))
                return 3; // III - Piceri

            if (category.Contains("pjat") || category.Contains("kryesor") || category.Contains("skare") ||
                category.Contains("mish") || category.Contains("stek") ||
                category.Contains("sallat") || category.Contains("salat") || category.Contains("salad"))
                return 2; // II - Pjata kryesore

            if (string.Equals(destination, "Pizza", StringComparison.OrdinalIgnoreCase))
                return 3;
            if (string.Equals(destination, "Kitchen", StringComparison.OrdinalIgnoreCase))
                return 2;

            return 5;
        }

        private string GetPrintGroupTitle(int groupOrder)
        {
            switch (groupOrder)
            {
                case 1: return "I - PARAHAJET";
                case 2: return "II - PJATAT KRYESORE";
                case 3: return "III - PICERI";
                case 4: return "SHANGT";
                default: return "POROSI";
            }
        }

        // TableID është ID e brendshme e databazës; për printim duhet TableNumber (p.sh. 1, jo ID 14).
        private int GetRealTableNumber(int tableId)
        {
            if (tableId <= 0) return tableId;
            try
            {
                using (SqlConnection con = DbConnection.GetConnection())
                {
                    con.Open();
                    using (SqlCommand cmd = new SqlCommand(
                        "SELECT TableNumber FROM RestaurantTables WHERE TableID = @id", con))
                    {
                        cmd.Parameters.AddWithValue("@id", tableId);
                        object value = cmd.ExecuteScalar();
                        if (value != null && value != DBNull.Value)
                            return Convert.ToInt32(value);
                    }
                }
            }
            catch
            {
                // Në rast gabimi, mos e ndalojmë printimin; përdorim vlerën që kemi.
            }
            return tableId;
        }

        private bool PrintPendingOrderItems(
            int orderId,
            string waiterName,
            int tableNumber)
        {
            List<PendingPrintItem> items = GetPendingPrintItems(orderId);
            if (items == null || items.Count == 0)
            {
                MessageBox.Show("Nuk ka produkte te reja per t'u printuar.", "Printeri",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
                return false;
            }

            // Renditja është e qëndrueshme: I sallatat, II pjatat kryesore,
            // III picat; çdo grup dërgohet si fletë më vete dhe pritet veçmas.
            List<int> groupOrders = new List<int>();
            foreach (PendingPrintItem item in items)
            {
                int groupOrder = GetPrintGroupOrder(item);
                if (!groupOrders.Contains(groupOrder))
                    groupOrders.Add(groupOrder);
            }
            groupOrders.Sort();

            List<byte> output = new List<byte>();
            output.AddRange(new byte[] { 0x1B, 0x40 }); // ESC @ initialize

            foreach (int groupOrder in groupOrders)
            {
                output.AddRange(new byte[] { 0x1B, 0x61, 0x01 }); // center
                // Ne fletet e porosise nuk shtypet logoja; logoja mbetet vetem ne llogari.
                output.AddRange(EscPosText("RESTAURANT MEROVA\n"));
                output.AddRange(new byte[] { 0x1B, 0x45, 0x01 }); // bold on
                output.AddRange(EscPosText(GetPrintGroupTitle(groupOrder) + "\n"));
                output.AddRange(new byte[] { 0x1B, 0x45, 0x00 }); // bold off
                output.AddRange(new byte[] { 0x1B, 0x61, 0x00 }); // left
                output.AddRange(EscPosText("------------------------------------------\n"));
                output.AddRange(EscPosText("Kamarieri: " + CleanForPos(waiterName) + "\n"));
                output.AddRange(EscPosText("T" + tableNumber + "\n"));
                output.AddRange(EscPosText(DateTime.Now.ToString("dd.MM.yyyy HH:mm") + "\n"));
                output.AddRange(EscPosText("------------------------------------------\n"));

                foreach (PendingPrintItem item in items)
                {
                    if (GetPrintGroupOrder(item) != groupOrder)
                        continue;

                    // Artikulli majtas; shuma e rreshtit e rreshtuar në skajin e djathtë.
                    string itemText = item.Quantity + " x " + CleanForPos(item.ProductName);
                    string amountText = (item.UnitPrice * item.Quantity).ToString("0.00") + " den";
                    const int ticketWidth = 42; // afërsisht 42 karaktere në letër 80 mm
                    int itemTextMax = ticketWidth - amountText.Length - 1;
                    if (itemText.Length > itemTextMax)
                        itemText = itemText.Substring(0, itemTextMax);
                    string ticketLine = itemText.PadRight(ticketWidth - amountText.Length) + amountText;
                    output.AddRange(new byte[] { 0x1B, 0x45, 0x01 }); // bold on
                    output.AddRange(EscPosText(ticketLine + "\n"));
                    output.AddRange(new byte[] { 0x1B, 0x45, 0x00 }); // bold off

                    // Komenti shtypet menjëherë poshtë ushqimit, pa fjalën "Koment:".
                    if (!string.IsNullOrWhiteSpace(item.Comment))
                    {
                        output.AddRange(EscPosText("  " + CleanForPos(item.Comment.Trim()) + "\n"));
                    }
                }

                output.AddRange(EscPosText("\n------------------------------------------\n\n"));
                output.AddRange(new byte[] { 0x1B, 0x64, 0x04 }); // feed 4 lines
                output.AddRange(new byte[] { 0x1D, 0x56, 0x00 }); // cut after THIS ticket
            }

            if (!RawPrinterHelper.SendBytesToPrinter(TestPrinterName, output.ToArray()))
                throw new Exception("Printeri nuk pranoi te dhenat RAW. Kontrollo lidhjen dhe porten e printerit.");

            return true;
        }


        private void MarkOrderItemsAsPrinted(int orderId)
        {
            using (SqlConnection con = DbConnection.GetConnection())
            {
                con.Open();

                string query = @"
                    UPDATE OrderItems
                    SET PrintedQuantity = Quantity
                    WHERE OrderID = @OrderID
                      AND PrintedQuantity < Quantity";

                using (SqlCommand cmd =
                       new SqlCommand(query, con))
                {
                    cmd.Parameters.AddWithValue(
                        "@OrderID",
                        orderId
                    );

                    cmd.ExecuteNonQuery();
                }
            }
        }


