        // =========================================
        // TEMA PROFESIONALE E NDERFAQES
        // =========================================
        private void ApplyProfessionalTheme(Control root)
        {
            if (root == null)
                return;

            this.Font = new Font("Segoe UI", 10F, FontStyle.Regular);
            this.BackColor = Color.FromArgb(241, 245, 249);

            foreach (Control control in root.Controls)
            {
                Button button = control as Button;
                if (button != null)
                {
                    button.FlatStyle = FlatStyle.Flat;
                    button.FlatAppearance.BorderSize = 0;
                    button.FlatAppearance.MouseOverBackColor = Color.FromArgb(29, 78, 216);
                    button.FlatAppearance.MouseDownBackColor = Color.FromArgb(30, 64, 175);
                    button.Cursor = Cursors.Hand;
                    button.Font = new Font("Segoe UI", 10F, FontStyle.Bold);
                    button.UseVisualStyleBackColor = false;

                    string identity = ((button.Name ?? "") + " " + (button.Text ?? "")).ToLowerInvariant();

                    if (identity.Contains("fshi") || identity.Contains("anulo"))
                    {
                        button.BackColor = Color.FromArgb(220, 75, 75);
                        button.ForeColor = Color.White;
                        button.FlatAppearance.MouseOverBackColor = Color.FromArgb(190, 55, 55);
                    }
                    else if (identity.Contains("llogarin") ||
                             identity.Contains("pagu") ||
                             identity.Contains("shto"))
                    {
                        button.BackColor = Color.FromArgb(25, 135, 84);
                        button.ForeColor = Color.White;
                        button.FlatAppearance.MouseOverBackColor = Color.FromArgb(20, 110, 68);
                    }
                    else if (identity.Contains("kthehu") || identity.Contains("mbrapa"))
                    {
                        button.BackColor = Color.FromArgb(213, 224, 241);
                        button.ForeColor = Color.FromArgb(15, 23, 42);
                        button.FlatAppearance.MouseOverBackColor = Color.FromArgb(215, 225, 239);
                    }
                    else
                    {
                        button.BackColor = Color.FromArgb(37, 99, 235);
                        button.ForeColor = Color.White;
                    }
                }

                DataGridView grid = control as DataGridView;
                if (grid != null)
                {
                    grid.BackgroundColor = Color.White;
                    grid.BorderStyle = BorderStyle.None;
                    grid.GridColor = Color.FromArgb(226, 232, 240);
                    grid.EnableHeadersVisualStyles = false;
                    grid.ColumnHeadersBorderStyle = DataGridViewHeaderBorderStyle.None;
                    grid.ColumnHeadersDefaultCellStyle.BackColor = Color.FromArgb(23, 37, 84);
                    grid.ColumnHeadersDefaultCellStyle.ForeColor = Color.White;
                    grid.ColumnHeadersDefaultCellStyle.Font = new Font("Segoe UI", 10F, FontStyle.Bold);
                    grid.ColumnHeadersDefaultCellStyle.Padding = new Padding(8, 5, 8, 5);
                    grid.DefaultCellStyle.Font = new Font("Segoe UI", 10F, FontStyle.Regular);
                    grid.DefaultCellStyle.ForeColor = Color.FromArgb(15, 23, 42);
                    grid.DefaultCellStyle.BackColor = Color.White;
                    grid.DefaultCellStyle.SelectionBackColor = Color.FromArgb(191, 219, 254);
                    grid.DefaultCellStyle.SelectionForeColor = Color.FromArgb(25, 45, 75);
                    grid.AlternatingRowsDefaultCellStyle.BackColor = Color.FromArgb(241, 245, 249);
                    grid.RowHeadersVisible = false;
                    grid.RowTemplate.Height = 34;
                }

                TextBox textBox = control as TextBox;
                if (textBox != null)
                {
                    textBox.Font = new Font("Segoe UI", 10F, FontStyle.Regular);
                    textBox.BorderStyle = BorderStyle.FixedSingle;
                    textBox.BackColor = Color.White;
                    textBox.ForeColor = Color.FromArgb(15, 23, 42);
                }

                ComboBox comboBox = control as ComboBox;
                if (comboBox != null)
                {
                    comboBox.Font = new Font("Segoe UI", 10F, FontStyle.Regular);
                    comboBox.FlatStyle = FlatStyle.Flat;
                    comboBox.BackColor = Color.White;
                    comboBox.ForeColor = Color.FromArgb(15, 23, 42);
                }

                // Aplikohet në mënyrë rekursive edhe te panelet e menaxhimit.
                if (control.HasChildren)
                    ApplyProfessionalTheme(control);
            }
        }


        // =========================================
        // PANELI I POROSISË MBI KATEGORITË
