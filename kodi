        // =====================================================
        // PRINTIMI I LLOGARISË - FORMAT 80mm
        // =====================================================
        // Për testim përdorim HP LaserJet MFP M28-M31.
        // Më vonë kjo metodë do të përdorë printerin POS të SHANGT-it.
        private bool PrintBill80mm(
            List<OrderItem> items,
            string waiterName,
            int tableNumber,
            decimal total)
        {
            if (items == null || items.Count == 0)
            {
                MessageBox.Show("Nuk ka produkte ne kete porosi.", "Llogaria",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);
                return false;
            }

            var output = new List<byte>();
            output.AddRange(new byte[] { 0x1B, 0x40 });
            output.AddRange(new byte[] { 0x1B, 0x61, 0x01 }); // center
            output.AddRange(GetLogoEscPosBytes(200));
            // Titull me shkronja me te medha; telefoni vjen menjehere poshte.
            output.AddRange(new byte[] { 0x1D, 0x21, 0x11 }); // double width + double height
            output.AddRange(new byte[] { 0x1B, 0x45, 0x01 });
            output.AddRange(EscPosText("RESTAURANT MEROVA\n"));
            output.AddRange(new byte[] { 0x1D, 0x21, 0x00 }); // normal size
            output.AddRange(new byte[] { 0x1B, 0x45, 0x00 });
            output.AddRange(EscPosText("Tel: 072 631 013\n"));
            output.AddRange(new byte[] { 0x1B, 0x61, 0x00 });
            output.AddRange(EscPosText(PadTicketSides("LLOGARIA", "Tavolina: " + tableNumber) + "\n"));
            output.AddRange(EscPosText("------------------------------------------\n"));
            output.AddRange(EscPosText("Kamarieri: " + CleanForPos(waiterName) + "\n"));
            output.AddRange(EscPosText("Data: " + DateTime.Now.ToString("dd.MM.yyyy HH:mm") + "\n"));
            output.AddRange(EscPosText("------------------------------------------\n"));
            output.AddRange(EscPosText("Artikulli       Sasia  Cmimi   Shuma\n"));
            output.AddRange(EscPosText("------------------------------------------\n"));

            foreach (OrderItem item in items)
            {
                string name = CleanForPos(item.ProductName);
                if (name.Length > 15) name = name.Substring(0, 15);
                string qty = item.Quantity + "x";
                string price = item.UnitPrice.ToString("0.00");
                string lineTotal = (item.UnitPrice * item.Quantity).ToString("0.00");
                output.AddRange(EscPosText(name.PadRight(16) + qty.PadLeft(5) + price.PadLeft(8) + lineTotal.PadLeft(9) + "\n"));
            }

            output.AddRange(EscPosText("------------------------------------------\n"));
            output.AddRange(new byte[] { 0x1B, 0x45, 0x01 });
            output.AddRange(EscPosText("TOTAL: " + total.ToString("0.00") + " DEN\n"));
            output.AddRange(new byte[] { 0x1B, 0x45, 0x00 });
            output.AddRange(EscPosText("------------------------------------------\n"));
            output.AddRange(new byte[] { 0x1B, 0x61, 0x01 });
            output.AddRange(EscPosText("Ju faleminderit!\n\n"));
            output.AddRange(new byte[] { 0x1B, 0x64, 0x05 });
            output.AddRange(new byte[] { 0x1D, 0x56, 0x00 });

            if (!RawPrinterHelper.SendBytesToPrinter(TestPrinterName, output.ToArray()))
                throw new Exception("Printeri nuk pranoi te dhenat RAW. Kontrollo lidhjen dhe porten e printerit.");
            return true;
        }

        private static string PadTicketSides(string left, string right)
        {
            const int width = 42;
            left = CleanForPos(left ?? "");
            right = CleanForPos(right ?? "");
            return left + new string(' ', Math.Max(1, width - left.Length - right.Length)) + right;
        }

        private static Bitmap CreateTrimmedRestaurantLogo()
        {
            using (Bitmap source = new Bitmap(RestaurantLogoPath))
            {
                int minX = source.Width, minY = source.Height, maxX = -1, maxY = -1;
                for (int y = 0; y < source.Height; y++)
                {
                    for (int x = 0; x < source.Width; x++)
                    {
                        Color c = source.GetPixel(x, y);
                        if ((c.R + c.G + c.B) / 3 < 225)
                        {
                            if (x < minX) minX = x;
                            if (x > maxX) maxX = x;
                            if (y < minY) minY = y;
                            if (y > maxY) maxY = y;
                        }
                    }
                }
                if (maxX < minX || maxY < minY)
                    return new Bitmap(source);

                int pad = Math.Max(4, Math.Min(source.Width, source.Height) / 50);
                minX = Math.Max(0, minX - pad);
                minY = Math.Max(0, minY - pad);
                maxX = Math.Min(source.Width - 1, maxX + pad);
                maxY = Math.Min(source.Height - 1, maxY + pad);
                Rectangle crop = Rectangle.FromLTRB(minX, minY, maxX + 1, maxY + 1);
                return source.Clone(crop, source.PixelFormat);
            }
        }

        private static byte[] GetLogoEscPosBytes(int targetWidth)
        {
            if (!System.IO.File.Exists(RestaurantLogoPath)) return new byte[0];
            using (Bitmap source = CreateTrimmedRestaurantLogo())
            {
                int width = Math.Max(8, targetWidth - targetWidth % 8);
                int height = Math.Max(1, (int)Math.Round(source.Height * (width / (double)source.Width)));
                using (Bitmap resized = new Bitmap(width, height))
                using (Graphics graphics = Graphics.FromImage(resized))
                {
                    graphics.Clear(Color.White);
                    graphics.InterpolationMode = InterpolationMode.HighQualityBicubic;
                    graphics.DrawImage(source, 0, 0, width, height);
                    int bytesPerRow = width / 8;
                    List<byte> data = new List<byte>();
                    data.AddRange(new byte[] { 0x1D, 0x76, 0x30, 0x00,
                        (byte)(bytesPerRow & 255), (byte)((bytesPerRow >> 8) & 255),
                        (byte)(height & 255), (byte)((height >> 8) & 255) });
                    for (int y = 0; y < height; y++)
                        for (int bx = 0; bx < bytesPerRow; bx++)
                        {
                            byte value = 0;
                            for (int bit = 0; bit < 8; bit++)
                            {
                                Color pixel = resized.GetPixel(bx * 8 + bit, y);
                                if ((pixel.R + pixel.G + pixel.B) / 3 < 160)
                                    value |= (byte)(0x80 >> bit);
                            }
                            data.Add(value);
                        }
                    data.Add(10);
                    return data.ToArray();
                }
            }
        }

        private static byte[] EscPosText(string value)
        {
            // Tekst i sigurt per printera POS me charset bazik; shmang karakteret Unicode qe mund te dalin bosh.
            return Encoding.ASCII.GetBytes(CleanForPos(value));
        }

        private static string CleanForPos(string value)
        {
            if (string.IsNullOrEmpty(value)) return string.Empty;
            return value.Replace("ë", "e").Replace("Ë", "E")
                        .Replace("ç", "c").Replace("Ç", "C")
                        .Replace("€", "EUR").Replace("–", "-").Replace("—", "-");
        }

        private static class RawPrinterHelper
        {
            [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
            private class DOCINFO
            {
                [MarshalAs(UnmanagedType.LPWStr)] public string pDocName;
                [MarshalAs(UnmanagedType.LPWStr)] public string pOutputFile;
                [MarshalAs(UnmanagedType.LPWStr)] public string pDataType;
            }

            [DllImport("winspool.drv", EntryPoint = "OpenPrinterW", SetLastError = true, CharSet = CharSet.Unicode)]
            private static extern bool OpenPrinter(string pPrinterName, out IntPtr phPrinter, IntPtr pDefault);
            [DllImport("winspool.drv", SetLastError = true)]
            private static extern bool ClosePrinter(IntPtr hPrinter);
            [DllImport("winspool.drv", EntryPoint = "StartDocPrinterW", SetLastError = true, CharSet = CharSet.Unicode)]
            private static extern int StartDocPrinter(IntPtr hPrinter, int level, [In] DOCINFO di);
            [DllImport("winspool.drv", SetLastError = true)]
            private static extern bool EndDocPrinter(IntPtr hPrinter);
            [DllImport("winspool.drv", SetLastError = true)]
            private static extern bool StartPagePrinter(IntPtr hPrinter);
            [DllImport("winspool.drv", SetLastError = true)]
            private static extern bool EndPagePrinter(IntPtr hPrinter);
            [DllImport("winspool.drv", SetLastError = true)]
            private static extern bool WritePrinter(IntPtr hPrinter, IntPtr pBytes, int dwCount, out int dwWritten);

            public static bool SendBytesToPrinter(string printerName, byte[] bytes)
            {
                IntPtr hPrinter = IntPtr.Zero;
                IntPtr pBytes = IntPtr.Zero;
                bool success = false;
                if (bytes == null || bytes.Length == 0) return false;
                try
                {
                    if (!OpenPrinter(printerName, out hPrinter, IntPtr.Zero)) return false;
                    DOCINFO doc = new DOCINFO { pDocName = "Restaurant Merova POS Ticket", pOutputFile = null, pDataType = "RAW" };
                    if (StartDocPrinter(hPrinter, 1, doc) == 0) return false;
                    if (!StartPagePrinter(hPrinter)) { EndDocPrinter(hPrinter); return false; }
                    pBytes = Marshal.AllocHGlobal(bytes.Length);
                    Marshal.Copy(bytes, 0, pBytes, bytes.Length);
                    int written;
                    success = WritePrinter(hPrinter, pBytes, bytes.Length, out written) && written == bytes.Length;
                    EndPagePrinter(hPrinter);
                    EndDocPrinter(hPrinter);
                }
                finally
                {
                    if (pBytes != IntPtr.Zero) Marshal.FreeHGlobal(pBytes);
                    if (hPrinter != IntPtr.Zero) ClosePrinter(hPrinter);
                }
                return success;
            }
        }



        private void btnShtypLlogarine_Click(
            object sender,
            EventArgs e)
        {
            // Llogaria duhet të dalë vetëm për një porosi Open.
            if (selectedOpenOrderId == 0)
            {
                MessageBox.Show(
                    "Nuk ka porosi të hapur për këtë tavolinë.",
                    "Llogaria",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Information
                );
                return;
            }

            if (selectedTableId == 0)
            {
                MessageBox.Show(
                    "Nuk është zgjedhur tavolina.",
                    "Kujdes",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning
                );
                return;
            }

            decimal total = 0;

            foreach (OrderItem item in currentOrder)
            {
                total += item.Total;
            }

            try
            {
                using (SqlConnection con = DbConnection.GetConnection())
                {
                    con.Open();

                    using (SqlTransaction transaction = con.BeginTransaction())
                    {
                        try
                        {
                            // =========================================
                            // 1. PRINTIMI REAL I LLOGARISË
                            // =========================================
                            // Për momentin përdorim HP-në si printer testues.
                            // Më vonë llogaria do të dërgohet vetëm te
                            // printeri fizik POS i SHANGT-it.

                            bool printedBill = PrintBill80mm(
                                currentOrder,
                                selectedWaiter,
                                GetRealTableNumber(selectedTableId),
                                total
                            );

                            if (!printedBill)
                            {
                                throw new Exception(
                                    "Llogaria nuk u printua."
                                );
                            }

                            // =========================================
                            // 2. FSHIJMË PRODUKTET E POROSISË
                            // =========================================
                            string deleteItemsQuery = @"
                                DELETE FROM OrderItems
                                WHERE OrderID = @OrderID";

                            using (SqlCommand cmd = new SqlCommand(
                                deleteItemsQuery,
                                con,
                                transaction))
                            {
                                cmd.Parameters.AddWithValue(
                                    "@OrderID",
                                    selectedOpenOrderId
                                );

                                cmd.ExecuteNonQuery();
                            }

                            // =========================================
                            // 3. FSHIJMË POROSINË
                            // =========================================
                            string deleteOrderQuery = @"
                                DELETE FROM Orders
                                WHERE OrderID = @OrderID
                                  AND Status = 'Open'";

                            using (SqlCommand cmd = new SqlCommand(
                                deleteOrderQuery,
                                con,
                                transaction))
                            {
                                cmd.Parameters.AddWithValue(
                                    "@OrderID",
                                    selectedOpenOrderId
                                );

                                cmd.ExecuteNonQuery();
                            }

                            // =========================================
                            // 4. TAVOLINA BËHET PËRSËRI E LIRË
                            // =========================================
                            string freeTableQuery = @"
                                UPDATE RestaurantTables
                                SET Status = 'Free'
                                WHERE TableID = @TableID";

                            using (SqlCommand cmd = new SqlCommand(
                                freeTableQuery,
                                con,
                                transaction))
                            {
                                cmd.Parameters.AddWithValue(
                                    "@TableID",
                                    selectedTableId
                                );

                                cmd.ExecuteNonQuery();
                            }

                            transaction.Commit();

                            // =========================================
                            // 5. PASTROJMË MEMORIEN
                            // =========================================
                            currentOrder.Clear();
                            RefreshOrderDisplay();

                            selectedOpenOrderId = 0;
                            selectedTableId = 0;
                            selectedOrderCategoryId = 0;

                            // =========================================
                            // 6. KTHEHEMI TE KAMARIERËT
                            // =========================================
                            pnlPorosia.Visible = false;
                            pnlUshqimet.Visible = false;
                            pnlKategorite.Visible = false;
                            pnlTavolinat.Visible = false;
                            pnlAmbienti.Visible = false;

                            pnlMain.Visible = true;
                            panel1.Visible = true;

                            // Kur kthehemi te zgjedhja e kamarierit, mos shfaqim
                            // kamarierin dhe tavolinën e porosisë së kaluar.
                            if (lblOrderContext != null)
                            {
                                lblOrderContext.Text = "";
                                lblOrderContext.Visible = false;
                            }

                            LoadWaiters();

                            MessageBox.Show(
                                "Llogaria u mbyll me sukses.\n\n" +
                                "Tavolina tani është përsëri e lirë.",
                                "Llogaria e mbyllur",
                                MessageBoxButtons.OK,
                                MessageBoxIcon.Information
                            );
                        }
                        catch
                        {
                            transaction.Rollback();
                            throw;
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Gabim gjatë mbylljes së llogarisë:\n\n" +
                    ex.Message,
                    "Gabim",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error
                );
            }
        }


