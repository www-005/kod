        // =========================================
        // LOAD WAITERS FROM DATABASE
        // =========================================
        private bool PromptForWaiterId(int waiterId, string waiterName)
        {
            using (Form dialog = new Form())
            {
                dialog.Text = "Verifikimi i kamarierit";
                dialog.FormBorderStyle = FormBorderStyle.FixedDialog;
                dialog.StartPosition = FormStartPosition.CenterScreen;
                dialog.ClientSize = new Size(300, 390);
                dialog.MaximizeBox = false;
                dialog.MinimizeBox = false;
                dialog.ShowInTaskbar = false;
                dialog.BackColor = Color.FromArgb(239, 244, 251);

                Label title = new Label { Text = "Shëno ID-në e kamarierit", Font = new Font("Segoe UI", 13, FontStyle.Bold), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(10, 10), Size = new Size(280, 35) };
                Label who = new Label { Text = waiterName, Font = new Font("Segoe UI", 10, FontStyle.Bold), TextAlign = ContentAlignment.MiddleCenter, Location = new Point(10, 45), Size = new Size(280, 25) };
                TextBox entry = new TextBox { Font = new Font("Segoe UI", 18, FontStyle.Bold), TextAlign = HorizontalAlignment.Center, ReadOnly = false, PasswordChar = '*', Location = new Point(25, 75), Size = new Size(250, 38), BackColor = Color.White };
                entry.KeyPress += (sender, args) =>
                {
                    if (!char.IsControl(args.KeyChar) && !char.IsDigit(args.KeyChar))
                        args.Handled = true;
                };
                dialog.Controls.AddRange(new Control[] { title, who, entry });

                string[] keys = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "Fshi", "0", "⌫" };
                for (int i = 0; i < keys.Length; i++)
                {
                    string key = keys[i];
                    Button b = new Button { Text = key, Font = new Font("Segoe UI", 13, FontStyle.Bold), Size = new Size(78, 48), Location = new Point(22 + (i % 3) * 86, 125 + (i / 3) * 53), BackColor = Color.White, ForeColor = Color.FromArgb(15, 23, 42), FlatStyle = FlatStyle.Flat };
                    b.FlatAppearance.BorderColor = Color.FromArgb(160, 175, 195);
                    b.Click += (sender, args) =>
                    {
                        if (key == "Fshi") entry.Clear();
                        else if (key == "⌫") { if (entry.Text.Length > 0) entry.Text = entry.Text.Substring(0, entry.Text.Length - 1); }
                        else if (entry.Text.Length < 10) entry.Text += key;
                    };
                    dialog.Controls.Add(b);
                }
                Button ok = new Button { Text = "VAZHDO", Font = new Font("Segoe UI", 10, FontStyle.Bold), Location = new Point(22, 340), Size = new Size(122, 38), BackColor = Color.FromArgb(37, 99, 235), ForeColor = Color.White, FlatStyle = FlatStyle.Flat, DialogResult = DialogResult.OK };
                Button cancel = new Button { Text = "ANULO", Font = new Font("Segoe UI", 10, FontStyle.Bold), Location = new Point(156, 340), Size = new Size(122, 38), BackColor = Color.FromArgb(71, 85, 105), ForeColor = Color.White, FlatStyle = FlatStyle.Flat, DialogResult = DialogResult.Cancel };
                dialog.Controls.Add(ok); dialog.Controls.Add(cancel); dialog.AcceptButton = ok; dialog.CancelButton = cancel;
                if (dialog.ShowDialog(this) != DialogResult.OK) return false;
                if (!int.TryParse(entry.Text, out int enteredId) || enteredId != waiterId)
                {
                    MessageBox.Show("ID-ja nuk është e saktë për këtë kamarier.", "Verifikim", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return false;
                }

                // Verifikimi bëhet sipas ID-së dhe statusit aktiv në databazë.
                // Emri në kartë mund të përmbajë simbole/ndërprerje rreshti, ndaj nuk krahasohet me Name.
                try
                {
                    using (SqlConnection connection = DbConnection.GetConnection())
                    {
                        connection.Open();
                        using (SqlCommand cmd = new SqlCommand(
                            "SELECT COUNT(1) FROM Kamarierat WHERE WaiterID = @id AND Active = 1", connection))
                        {
                            cmd.Parameters.Add("@id", SqlDbType.Int).Value = enteredId;
                            if (Convert.ToInt32(cmd.ExecuteScalar()) != 1)
                            {
                                MessageBox.Show("Kamarieri nuk u verifikua në databazë ose nuk është aktiv.", "Verifikim", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                                return false;
                            }
                        }
                    }
                }
                catch (Exception ex)
                {
                    MessageBox.Show("Nuk mund të verifikohet ID-ja në databazë.\n" + ex.Message, "Gabim", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    return false;
                }
                return true;
            }
        }

        private void LoadWaiters()
        {
            try
            {
                flowWaiters.Controls.Clear();

                using (SqlConnection con = DbConnection.GetConnection())
                {
                    con.Open();

                    string query = @"
                        SELECT WaiterID, Name
                        FROM Kamarierat
                        WHERE Active = 1
                        ORDER BY Name";

                    using (SqlCommand cmd = new SqlCommand(query, con))
                    {
                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                int waiterId =
                                    Convert.ToInt32(reader["WaiterID"]);

                                string waiterName =
                                    reader["Name"].ToString();

                                Panel waiterPanel =
                                    CreateWaiterPanel(
                                        waiterId,
                                        waiterName
                                    );

                                flowWaiters.Controls.Add(
                                    waiterPanel
                                );
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Gabim gjatë ngarkimit të kamarierëve:\n\n" +
                    ex.Message,
                    "Gabim",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error
                );
            }
        }


