        private void btnShtoKamarier_Click(
            object sender,
            EventArgs e)
        {
            string emri =
                txtEmriKamarierit.Text.Trim();

            if (string.IsNullOrWhiteSpace(emri))
            {
                MessageBox.Show(
                    "Shkruaj emrin e kamarierit.",
                    "Kujdes",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning
                );

                txtEmriKamarierit.Focus();
                return;
            }

            try
            {
                using (SqlConnection con =
                       DbConnection.GetConnection())
                {
                    con.Open();

                    string query = @"
                        INSERT INTO Kamarierat
                        (Name, Active)
                        VALUES
                        (@Name, 1)";

                    using (SqlCommand cmd =
                           new SqlCommand(query, con))
                    {
                        cmd.Parameters.AddWithValue(
                            "@Name",
                            emri
                        );

                        cmd.ExecuteNonQuery();
                    }
                }

                MessageBox.Show(
                    "Kamarieri u shtua me sukses!",
                    "Sukses",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Information
                );

                txtEmriKamarierit.Clear();
                selectedManagementWaiterId = 0;

                LoadKamarieret();
                LoadWaiters();
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Gabim gjatë shtimit të kamarierit:\n\n" +
                    ex.Message,
                    "Gabim",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error
                );
            }
        }


