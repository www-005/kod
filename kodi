        private void LoadKategorite()
        {
            try
            {
                using (SqlConnection con =
                       DbConnection.GetConnection())
                {
                    con.Open();

                    string query = @"
                        SELECT
                            CategoryID,
                            Name
                        FROM Categories
                        ORDER BY CASE
                            WHEN LOWER(LTRIM(RTRIM(Name))) COLLATE Latin1_General_CI_AI IN (N'pije', N'pijet') THEN 1
                            WHEN LOWER(LTRIM(RTRIM(Name))) COLLATE Latin1_General_CI_AI IN (N'embelsira', N'embelsirat') THEN 2
                            WHEN LOWER(LTRIM(RTRIM(Name))) COLLATE Latin1_General_CI_AI IN (N'parahaje', N'parahajet') THEN 3
                            WHEN LOWER(LTRIM(RTRIM(Name))) COLLATE Latin1_General_CI_AI = N'pasta' THEN 4
                            WHEN LOWER(LTRIM(RTRIM(Name))) COLLATE Latin1_General_CI_AI IN (N'pizza', N'pica') THEN 5
                            WHEN LOWER(LTRIM(RTRIM(Name))) COLLATE Latin1_General_CI_AI = N'pjata kryesore' THEN 6
                            ELSE 99
                        END, Name";

                    using (SqlDataAdapter adapter =
                           new SqlDataAdapter(query, con))
                    {
                        DataTable table =
                            new DataTable();

                        adapter.Fill(table);

                        dgvKategorite.DataSource =
                            table;
                    }
                }

                if (dgvKategorite.Columns[
                    "CategoryID"] != null)
                {
                    dgvKategorite.Columns[
                        "CategoryID"
                    ].HeaderText = "ID";
                }

                if (dgvKategorite.Columns[
                    "Name"] != null)
                {
                    dgvKategorite.Columns[
                        "Name"
                    ].HeaderText = "Emri";
                }

                dgvKategorite.AutoSizeColumnsMode =
                    DataGridViewAutoSizeColumnsMode.Fill;

                dgvKategorite.SelectionMode =
                    DataGridViewSelectionMode.FullRowSelect;

                dgvKategorite.MultiSelect = false;
                dgvKategorite.ReadOnly = true;
                dgvKategorite.AllowUserToAddRows = false;
                dgvKategorite.AllowUserToDeleteRows = false;
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Gabim gjatë ngarkimit të kategorive:\n\n" +
                    ex.Message,
                    "Gabim",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error
                );
            }
        }


