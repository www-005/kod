        private void btnShtoUshqim_Click(
            object sender,
            EventArgs e)
        {
            string emri =
                txtEmriUshqimit.Text.Trim();

            if (string.IsNullOrWhiteSpace(emri))
            {
                MessageBox.Show(
                    "Shkruaj emrin e ushqimit.",
                    "Kujdes",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning
                );

                txtEmriUshqimit.Focus();
                return;
            }

            if (cmbKategoriaUshqimit.SelectedIndex == -1)
            {
                MessageBox.Show(
                    "Zgjidh kategorinë e ushqimit.",
                    "Kujdes",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning
                );

                cmbKategoriaUshqimit.Focus();
                return;
            }

            if (cmbDestinacioniUshqimit.SelectedIndex == -1)
            {
                MessageBox.Show(
                    "Zgjidh destinacionin e ushqimit.",
                    "Kujdes",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning
                );

                cmbDestinacioniUshqimit.Focus();
                return;
            }

            string cmimiText =
                txtCmimiUshqimit.Text
                .Trim()
                .Replace(',', '.');

            decimal cmimi;

            if (!decimal.TryParse(
                cmimiText,
                NumberStyles.Any,
                CultureInfo.InvariantCulture,
                out cmimi))
            {
                MessageBox.Show(
                    "Shkruaj një çmim të vlefshëm.\n\n" +
                    "Shembull: 5.50",
                    "Kujdes",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning
                );

                txtCmimiUshqimit.Focus();
                return;
            }

            if (cmimi < 0)
            {
                MessageBox.Show(
                    "Çmimi nuk mund të jetë negativ.",
                    "Kujdes",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning
                );

                return;
            }

            int categoryId;

            try
            {
                categoryId =
                    Convert.ToInt32(
                        cmbKategoriaUshqimit.SelectedValue
                    );
            }
            catch
            {
                MessageBox.Show(
                    "Zgjidh një kategori të vlefshme.",
                    "Kujdes",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Warning
                );

                return;
            }

            string destination =
                ((KeyValuePair<string, string>)cmbDestinacioniUshqimit.SelectedItem).Key;

            try
            {
                using (SqlConnection con =
                       DbConnection.GetConnection())
                {
                    con.Open();

                    string query = @"
                        INSERT INTO Products
                        (
                            CategoryID,
                            Name,
                            Price,
                            Destination,
                            Active
                        )
                        VALUES
                        (
                            @CategoryID,
                            @Name,
                            @Price,
                            @Destination,
                            1
                        )";

                    using (SqlCommand cmd =
                           new SqlCommand(query, con))
                    {
                        cmd.Parameters.AddWithValue(
                            "@CategoryID",
                            categoryId
                        );

                        cmd.Parameters.AddWithValue(
                            "@Name",
                            emri
                        );

                        SqlParameter priceParameter =
                            cmd.Parameters.Add(
                                "@Price",
                                SqlDbType.Decimal
                            );

                        priceParameter.Precision = 10;
                        priceParameter.Scale = 2;
                        priceParameter.Value = cmimi;

                        cmd.Parameters.AddWithValue(
                            "@Destination",
                            destination
                        );

                        cmd.ExecuteNonQuery();
                    }
                }

                MessageBox.Show(
                    "Ushqimi u shtua me sukses!",
                    "Sukses",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Information
                );

                ClearUshqimFields();

                LoadUshqimet();
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Gabim gjatë shtimit të ushqimit:\n\n" +
                    ex.Message,
                    "Gabim",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error
                );
            }
        }


