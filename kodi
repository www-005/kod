        private string GetCategoryIcon(string name)
        {
            string n = (name ?? "").ToLowerInvariant();
            if (n.Contains("embëls") || n.Contains("embels") || n.Contains("desert")) return "🍰";
            if (n.Contains("pic")) return "🍕";
            if (n.Contains("pije") || n.Contains("drink")) return "🥤";
            if (n.Contains("sallat")) return "🥗";
            if (n.Contains("kryesor") || n.Contains("mish") || n.Contains("stek")) return "🍽";
            if (n.Contains("mëngjes") || n.Contains("mengjes")) return "🍳";
            if (n.Contains("sup")) return "🥣";
            return "🍴";
        }

        private Color GetCategoryIconColor(string name)
        {
            string n = (name ?? "").ToLowerInvariant();
            if (n.Contains("embëls") || n.Contains("embels") || n.Contains("desert")) return Color.FromArgb(219, 92, 139);
            if (n.Contains("pic")) return Color.FromArgb(230, 126, 34);
            if (n.Contains("pije") || n.Contains("drink")) return Color.FromArgb(37, 139, 210);
            if (n.Contains("sallat")) return Color.FromArgb(35, 150, 95);
            if (n.Contains("kryesor") || n.Contains("mish") || n.Contains("stek")) return Color.FromArgb(173, 89, 47);
            if (n.Contains("mëngjes") || n.Contains("mengjes")) return Color.FromArgb(221, 166, 36);
            if (n.Contains("sup")) return Color.FromArgb(126, 87, 194);
            return Color.FromArgb(70, 105, 160);
        }

