        private void LoadTavolinat()
        {
            try
            {
                using (SqlConnection con =
                       DbConnection.GetConnection())
                {
                    con.Open();

                    string query = @"
                        SELECT
                            rt.TableID,
                            rt.AmbientID,
                            a.Name AS AmbientName,
                            rt.TableNumber,
                            rt.Status
                        FROM RestaurantTables rt
                        INNER JOIN Ambients a
                            ON rt.AmbientID = a.AmbientID
                        ORDER BY
                            a.Name,
                            rt.TableNumber";

                    using (SqlDataAdapter adapter =
                           new SqlDataAdapter(query, con))
                    {
                        DataTable table =
                            new DataTable();

                        adapter.Fill(table);

                        dgvTavolinat.DataSource =
                            table;
                    }
                }

                if (dgvTavolinat.Columns[
                    "TableID"] != null)
                {
                    dgvTavolinat.Columns[
                        "TableID"
                    ].HeaderText = "ID";
                }

                if (dgvTavolinat.Columns[
                    "AmbientID"] != null)
                {
                    dgvTavolinat.Columns[
                        "AmbientID"
                    ].Visible = false;
                }

                if (dgvTavolinat.Columns[
                    "AmbientName"] != null)
                {
                    dgvTavolinat.Columns[
                        "AmbientName"
                    ].HeaderText = "Ambienti";
                }

                if (dgvTavolinat.Columns[
                    "TableNumber"] != null)
                {
                    dgvTavolinat.Columns[
                        "TableNumber"
                    ].HeaderText = "Nr. Tavolinës";
                }

                if (dgvTavolinat.Columns[
                    "Status"] != null)
                {
                    dgvTavolinat.Columns[
                        "Status"
                    ].HeaderText = "Statusi";
                }

                dgvTavolinat.AutoSizeColumnsMode =
                    DataGridViewAutoSizeColumnsMode.Fill;

                dgvTavolinat.SelectionMode =
                    DataGridViewSelectionMode.FullRowSelect;

