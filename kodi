        private void LoadTablesForOrder()
        {
            try
            {
                flowTavolinat.Controls.Clear();

                if (selectedAmbientId == 0)
                    return;

                using (SqlConnection con = DbConnection.GetConnection())
                {
                    con.Open();

                    string query = @"
                        SELECT
                            TableID,
                            TableNumber,
                            Status
                        FROM RestaurantTables
                        WHERE AmbientID = @AmbientID
                        ORDER BY TableNumber";

                    using (SqlCommand cmd = new SqlCommand(query, con))
                    {
                        cmd.Parameters.AddWithValue("@AmbientID", selectedAmbientId);

                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                int tableId = Convert.ToInt32(reader["TableID"]);
                                int tableNumber = Convert.ToInt32(reader["TableNumber"]);
                                string status = reader["Status"].ToString();

                                Panel tablePanel = CreateTablePanel(
                                    tableId,
                                    tableNumber,
                                    status
                                );

                                flowTavolinat.Controls.Add(tablePanel);
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Gabim gjatë ngarkimit të tavolinave:\n\n" + ex.Message,
                    "Gabim",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error
                );
            }
        }


        // =====================================================
        // KRIJO KARTËN E TAVOLINËS
        // =====================================================
        private Panel CreateTablePanel(
            int tableId,
            int tableNumber,
            string status)
        {
            Panel panel = new Panel();

            panel.Width = 158;
            panel.Height = 116;
            panel.Margin = new Padding(6);
            panel.Padding = new Padding(6);
            panel.Cursor = Cursors.Hand;
            panel.Tag = tableId;
            panel.Cursor = Cursors.Hand;

            bool occupied = status.Equals(
                "Occupied",
                StringComparison.OrdinalIgnoreCase
            );

            panel.BackColor = occupied
                ? Color.FromArgb(190, 35, 45)
                : Color.FromArgb(226, 234, 246);

            // Statusi ruhet këtu që hover/click ta dinë gjendjen.
            panel.AccessibleName = status;

            MakePanelRounded(panel, 25);

            Label label = new Label();

            label.Text = (occupied ? "🔴" : "🟢") + "\nT" + tableNumber;
            label.Dock = DockStyle.Fill;
            label.TextAlign = ContentAlignment.MiddleCenter;
            label.Font = new Font(
                "Segoe UI Emoji",
                15,
                FontStyle.Bold
            );
            label.ForeColor = occupied ? Color.White : Color.Black;
            label.BackColor = Color.Transparent;
            label.Enabled = true;

            panel.Controls.Add(label);

            panel.MouseEnter += TablePanel_MouseEnter;
            panel.MouseLeave += TablePanel_MouseLeave;
            panel.Click += TablePanel_Click;

            label.MouseEnter += (s, e) => TablePanel_MouseEnter(panel, e);
            label.MouseLeave += (s, e) => TablePanel_MouseLeave(panel, e);
            label.Click += (s, e) => TablePanel_Click(panel, e);

            return panel;
        }


        // =====================================================
        // HOVER - TAVOLINA
        // =====================================================
        private void TablePanel_MouseEnter(
            object sender,
            EventArgs e)
        {
            Panel panel = sender as Panel;

            if (panel == null)
                return;

            bool occupied = panel.AccessibleName.Equals(
                "Occupied",
                StringComparison.OrdinalIgnoreCase
            );

            panel.BackColor = occupied
                ? Color.FromArgb(180, 40, 40)
                : hoverColor;

            if (panel.Controls.Count > 0)
            {
                Label label = panel.Controls[0] as Label;

                if (label != null)
                    label.ForeColor = Color.White;
            }
