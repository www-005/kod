        private void LoadKategoriteForOrder()
        {
            try
            {
                flowKategorite.Controls.Clear();
                selectedCategoryVisualPanel = null;

                if (pnlKategorite != null)
                    pnlKategorite.BackColor = categoryAreaColor;

                using (SqlConnection con = DbConnection.GetConnection())
                {
                    con.Open();

                    string query = @"
                        SELECT
                            CategoryID,
                            Name
                        FROM Categories
                        ORDER BY CASE
                            WHEN LOWER(LTRIM(RTRIM(Name))) COLLATE Latin1_General_CI_AI IN (N'pije', N'pijet') THEN 1
                            WHEN LOWER(LTRIM(RTRIM(Name))) COLLATE Latin1_General_CI_AI IN (N'embelsira', N'embelsirat') THEN 2
                            WHEN LOWER(LTRIM(RTRIM(Name))) COLLATE Latin1_General_CI_AI IN (N'parahaje', N'parahajet') THEN 3
                            WHEN LOWER(LTRIM(RTRIM(Name))) COLLATE Latin1_General_CI_AI = N'pasta' THEN 4
                            WHEN LOWER(LTRIM(RTRIM(Name))) COLLATE Latin1_General_CI_AI IN (N'pizza', N'pica') THEN 5
                            WHEN LOWER(LTRIM(RTRIM(Name))) COLLATE Latin1_General_CI_AI = N'pjata kryesore' THEN 6
                            ELSE 99
                        END, Name";

                    using (SqlCommand cmd = new SqlCommand(query, con))
                    {
                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                int categoryId =
                                    Convert.ToInt32(reader["CategoryID"]);

                                string categoryName =
                                    reader["Name"].ToString();

                                Panel categoryPanel =
                                    CreateCategoryPanel(
                                        categoryId,
                                        categoryName
                                    );

                                flowKategorite.Controls.Add(categoryPanel);
                            }
                        }
                    }
                }

                // =================================================
                // ZGJEDHIM AUTOMATIKISHT KATEGORINË E PARË
                // =================================================
                // Kështu sapo hapet tavolina shfaqen menjëherë
                // edhe kategoritë edhe ushqimet.
                if (flowKategorite.Controls.Count > 0)
                {
                    Control firstCategory =
                        flowKategorite.Controls[0];

                    if (firstCategory.Tag != null)
                    {
                        selectedOrderCategoryId =
                            Convert.ToInt32(firstCategory.Tag);

                        selectedCategoryVisualPanel =
                            firstCategory as Panel;

                        if (selectedCategoryVisualPanel != null)
                        {
                            selectedCategoryVisualPanel.BackColor =
                                categorySelectedColor;

                            if (selectedCategoryVisualPanel.Controls.Count > 0)
                            {
                                Label firstLabel =
                                    selectedCategoryVisualPanel.Controls[0] as Label;

                                if (firstLabel != null)
                                    firstLabel.ForeColor = Color.White;
                            }
                        }

                        LoadUshqimetForOrder();
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show(
                    "Gabim gjatë ngarkimit të kategorive:\n\n" +
                    ex.Message,
                    "Gabim",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error
                );
            }
        }


