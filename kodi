        // =====================================================
        // NGARKO POROSINË OPEN TË TAVOLINËS
        // =====================================================
        private bool LoadOpenOrderForTable(int tableId)
        {
            try
            {
                currentOrder.Clear();
                selectedOpenOrderId = 0;

                using (SqlConnection con = DbConnection.GetConnection())
                {
                    con.Open();

                    // Gjejmë porosinë Open të kësaj tavoline.
                    string orderQuery = @"
                        SELECT TOP 1
                            OrderID,
                            WaiterID
                        FROM Orders
                        WHERE TableID = @TableID
                          AND Status = 'Open'
                        ORDER BY CreatedAT DESC, OrderID DESC";

                    using (SqlCommand cmd = new SqlCommand(orderQuery, con))
                    {
                        cmd.Parameters.AddWithValue("@TableID", tableId);

                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            if (!reader.Read())
                                return false;

                            selectedOpenOrderId =
                                Convert.ToInt32(reader["OrderID"]);

                            selectedWaiterId =
                                Convert.ToInt32(reader["WaiterID"]);
                        }
                    }

                    // Marrim ÇDO rresht të OrderItems veçmas.
                    // Kjo është e rëndësishme sepse i njëjti produkt mund
                    // të shtohet disa herë si rresht i veçantë.
                    string itemsQuery = @"
                        SELECT
                            oi.ProductID,
                            p.Name,
                            oi.UnitPrice,
                            oi.Quantity,
                            ISNULL(oi.PrintedQuantity, 0) AS PrintedQuantity,
                            ISNULL(oi.Comment, '') AS Comment
                        FROM OrderItems oi
                        INNER JOIN Products p
                            ON p.ProductID = oi.ProductID
                        WHERE oi.OrderID = @OrderID
                        ORDER BY oi.OrderItemID";

                    using (SqlCommand cmd = new SqlCommand(itemsQuery, con))
                    {
                        cmd.Parameters.AddWithValue(
                            "@OrderID",
                            selectedOpenOrderId
                        );

                        using (SqlDataReader reader = cmd.ExecuteReader())
                        {
                            while (reader.Read())
                            {
                                currentOrder.Add(
                                    new OrderItem
                                    {
                                        ProductId =
                                            Convert.ToInt32(
                                                reader["ProductID"]
                                            ),

                                        ProductName =
                                            reader["Name"].ToString(),

                                        UnitPrice =
                                            Convert.ToDecimal(
                                                reader["UnitPrice"]
                                            ),

                                        Quantity =
                                            Convert.ToInt32(
                                                reader["Quantity"]
                                            ),

                                        AlreadyPrintedQuantity =
                                            Convert.ToInt32(
                                                reader["PrintedQuantity"]
                                            ),
                                        Comment = Convert.ToString(reader["Comment"])
                                    }
                                );
                            }
                        }
                    }
                }

                RefreshOrderDisplay();

                return currentOrder.Count > 0;
            }
            catch (Exception ex)
            {
                selectedOpenOrderId = 0;
                currentOrder.Clear();
                RefreshOrderDisplay();

                MessageBox.Show(
                    "Gabim gjatë ngarkimit të porosisë së tavolinës:\n\n" +
                    ex.Message,
                    "Gabim",
                    MessageBoxButtons.OK,
                    MessageBoxIcon.Error
                );

                return false;
            }
        }

