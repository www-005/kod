        private void MoveOrderPanelAboveCategories()
        {
            if (pnlPorosia == null)
                return;

            if (pnlPorosia.Parent != this)
            {
                Control oldParent = pnlPorosia.Parent;

                if (oldParent != null)
                    oldParent.Controls.Remove(pnlPorosia);

                this.Controls.Add(pnlPorosia);
            }

            // Paneli i porosisë është gjithmonë në të djathtë.
            // Gjerësia është pak më e madhe që të lexohen bukur
            // produkti, sasia dhe çmimi.
            pnlPorosia.Width = 310;
            pnlPorosia.Height = this.ClientSize.Height;
            pnlPorosia.Anchor = AnchorStyles.Top | AnchorStyles.Right | AnchorStyles.Bottom;
            pnlPorosia.Location = new Point(Math.Max(0, this.ClientSize.Width - pnlPorosia.Width), 0);
            pnlPorosia.BringToFront();
            LayoutOrderScreen();
        }

        private void Form1_Resize(object sender, EventArgs e)
        {
            if (pnlPorosia == null || pnlPorosia.Parent != this)
                return;

            pnlPorosia.Width = 310;
            pnlPorosia.Height = this.ClientSize.Height;
            pnlPorosia.Location = new Point(Math.Max(0, this.ClientSize.Width - pnlPorosia.Width), 0);
            LayoutOrderScreen();
            pnlPorosia.BringToFront();
        }

        // Rregullon zonat e porosisë që kategoritë të mos mbulojnë ushqimet.
        private void LayoutOrderScreen()
        {
            int orderWidth = pnlPorosia != null ? pnlPorosia.Width : 310;
            int contentWidth = Math.Max(400, this.ClientSize.Width - orderWidth);
            int contextHeight = 38;
            int categoryHeight = 94;
            bool foodOrderVisible = pnlUshqimet != null && pnlUshqimet.Visible &&
                                    pnlKategorite != null && pnlKategorite.Visible &&
                                    pnlTavolinat != null && !pnlTavolinat.Visible;

            // Informacioni i kamarierit/tavolinës shfaqet vetëm gjatë zgjedhjes së ushqimeve.
            if (lblOrderContext != null)
            {
                lblOrderContext.Visible = foodOrderVisible;
                lblOrderContext.SetBounds(0, 0, contentWidth, contextHeight);
            }

            if (pnlKategorite != null)
            {
                pnlKategorite.SetBounds(0, contextHeight, contentWidth, categoryHeight);
                pnlKategorite.Anchor = AnchorStyles.Top | AnchorStyles.Left;
                pnlKategorite.BackColor = Color.FromArgb(235, 241, 249);
                pnlKategorite.Padding = new Padding(8, 4, 8, 4);
                pnlKategorite.BringToFront();
            }

            if (pnlUshqimet != null)
            {
                pnlUshqimet.SetBounds(0, contextHeight + categoryHeight, contentWidth,
                    Math.Max(150, this.ClientSize.Height - contextHeight - categoryHeight));
                pnlUshqimet.Anchor = AnchorStyles.Top | AnchorStyles.Bottom | AnchorStyles.Left;
                pnlUshqimet.BackColor = pageColor;
            }

            if (flowUshqimet != null)
            {
                flowUshqimet.BackColor = pageColor;
                flowUshqimet.Padding = new Padding(6);
                flowUshqimet.Margin = new Padding(0);
                flowUshqimet.WrapContents = true;
                flowUshqimet.AutoScroll = true;
            }

            if (pnlPorosia != null)
                pnlPorosia.BringToFront();
            if (lblOrderContext != null && lblOrderContext.Visible)
                lblOrderContext.BringToFront();
        }

        // Shton kolonën Comment në OrderItems nëse databaza ende nuk e ka.
        // Kjo ruan komentet edhe pas printimit/ringarkimit të porosisë.
        private void EnsureOrderItemCommentColumn()
        {
            using (SqlConnection con = DbConnection.GetConnection())
            {
                con.Open();
                using (SqlCommand cmd = new SqlCommand(@"
                    IF COL_LENGTH('dbo.OrderItems', 'Comment') IS NULL
                        ALTER TABLE dbo.OrderItems ADD Comment NVARCHAR(500) NULL;", con))
                {
                    cmd.ExecuteNonQuery();
                }
            }
        }

        // Vendos logon transparente në header, para tekstit Restaurant Merova.
        // Përdor restaurant-logo1.png; logoja e llogarisë/printimit nuk ndryshohet.
        private void EnsureRestaurantHeaderLogo()
        {
            if (panel1 == null)
                return;

            if (!System.IO.File.Exists(RestaurantHeaderLogoPath))
            {
                System.Diagnostics.Debug.WriteLine(
                    "Nuk u gjet logoja e header-it: " + RestaurantHeaderLogoPath);
                return;
            }

            Control existingLogo = FindControlRecursive(panel1, "picRestaurantHeaderLogo");
            if (existingLogo != null)
                return;

            Label restaurantTitle = FindRestaurantTitle(panel1);
            Control targetParent = restaurantTitle != null ? restaurantTitle.Parent : panel1;

            PictureBox logo = new PictureBox();
            logo.Name = "picRestaurantHeaderLogo";
            logo.SizeMode = PictureBoxSizeMode.Zoom;
            logo.BackColor = Color.Transparent;
            logo.Size = new Size(46, 46);
            logo.Margin = Padding.Empty;
            logo.Padding = Padding.Empty;
            logo.TabStop = false;

            try
            {
                logo.Image = CreateTrimmedHeaderLogo();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine("Gabim gjatë ngarkimit të logos së header-it: " + ex.Message);
                logo.Dispose();
                return;
            }

            if (restaurantTitle != null)
            {
                // Logoja vendoset para titullit dhe titulli bëhet pak më kompakt.
                int logoX = Math.Max(4, restaurantTitle.Left - logo.Width - 10);
                int logoY = Math.Max(2, restaurantTitle.Top + (restaurantTitle.Height - logo.Height) / 2);
                logo.Location = new Point(logoX, logoY);

                try
                {
                    restaurantTitle.Font = new Font(
                        restaurantTitle.Font.FontFamily, 14.0f, FontStyle.Bold);
                    restaurantTitle.AutoSize = false;
                    restaurantTitle.TextAlign = ContentAlignment.MiddleLeft;
                }
                catch { }
            }
            else
            {
                logo.Location = new Point(8, Math.Max(4, (targetParent.ClientSize.Height - logo.Height) / 2));
            }

            logo.Anchor = AnchorStyles.Top | AnchorStyles.Left;
            targetParent.Controls.Add(logo);
            logo.BringToFront();
            logo.Visible = true;

            if (logo.Right > targetParent.ClientSize.Width)
                logo.Left = Math.Max(0, targetParent.ClientSize.Width - logo.Width - 4);
        }

        // Pret vetëm hapësirën plotësisht transparente rreth logos.
        // Alfa ruhet, prandaj në header nuk shfaqet sfond katror.
        private static Bitmap CreateTrimmedHeaderLogo()
        {
            using (Bitmap source = new Bitmap(RestaurantHeaderLogoPath))
            {
                int minX = source.Width, minY = source.Height;
                int maxX = -1, maxY = -1;

                for (int y = 0; y < source.Height; y++)
                {
                    for (int x = 0; x < source.Width; x++)
                    {
                        if (source.GetPixel(x, y).A > 10)
                        {
                            if (x < minX) minX = x;
                            if (x > maxX) maxX = x;
                            if (y < minY) minY = y;
                            if (y > maxY) maxY = y;
                        }
                    }
                }

                if (maxX < minX || maxY < minY)
                    return new Bitmap(source);

                int pad = Math.Max(2, Math.Min(source.Width, source.Height) / 100);
                minX = Math.Max(0, minX - pad);
                minY = Math.Max(0, minY - pad);
                maxX = Math.Min(source.Width - 1, maxX + pad);
                maxY = Math.Min(source.Height - 1, maxY + pad);

                Rectangle crop = Rectangle.FromLTRB(minX, minY, maxX + 1, maxY + 1);
                return source.Clone(crop, System.Drawing.Imaging.PixelFormat.Format32bppArgb);
            }
        }

        private Control FindControlRecursive(Control parent, string controlName)
        {
            if (parent == null) return null;
            foreach (Control control in parent.Controls)
            {
                if (string.Equals(control.Name, controlName, StringComparison.OrdinalIgnoreCase))
                    return control;
                Control found = FindControlRecursive(control, controlName);
                if (found != null) return found;
            }
            return null;
        }

        private Label FindRestaurantTitle(Control parent)
        {
            if (parent == null) return null;
            foreach (Control control in parent.Controls)
            {
                Label label = control as Label;
                if (label != null && (label.Text ?? "").IndexOf("Restaurant Merova", StringComparison.OrdinalIgnoreCase) >= 0)
                    return label;

                Label found = FindRestaurantTitle(control);
                if (found != null) return found;
            }
            return null;
        }

