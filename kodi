        private void TransferTable_Click(object sender, EventArgs e)
        {
            if (selectedTableId <= 0 || selectedOpenOrderId <= 0)
            {
                MessageBox.Show("Zgjidh një tavolinë me porosi të hapur për ta transferuar.", "Transferimi", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            List<KeyValuePair<int, string>> tables = new List<KeyValuePair<int, string>>();
            try
            {
                using (SqlConnection con = DbConnection.GetConnection())
                {
                    con.Open();
                    string q = @"SELECT rt.TableID, rt.TableNumber FROM RestaurantTables rt
                                 WHERE rt.TableID <> @CurrentTable
                                   AND NOT EXISTS (SELECT 1 FROM Orders o WHERE o.TableID = rt.TableID AND o.Status = 'Open')
                                 ORDER BY rt.TableNumber";
                    using (SqlCommand cmd = new SqlCommand(q, con))
                    {
                        cmd.Parameters.AddWithValue("@CurrentTable", selectedTableId);
                        using (SqlDataReader rd = cmd.ExecuteReader())
                            while (rd.Read()) tables.Add(new KeyValuePair<int, string>(Convert.ToInt32(rd["TableID"]), rd["TableNumber"].ToString()));
                    }
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Nuk u lexuan tavolinat: " + ex.Message, "Gabim", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return;
            }

            if (tables.Count == 0)
            {
                MessageBox.Show("Nuk ka tavolinë të lirë ku mund të transferohet porosia.", "Transferimi", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            using (Form dialog = new Form())
            using (ComboBox combo = new ComboBox())
            using (Button ok = new Button())
            using (Button cancel = new Button())
            {
                dialog.Text = "Transfero porosinë";
                dialog.StartPosition = FormStartPosition.CenterParent;
                dialog.FormBorderStyle = FormBorderStyle.FixedDialog;
                dialog.ClientSize = new Size(430, 190);
                dialog.MinimizeBox = false; dialog.MaximizeBox = false;
                Label label = new Label { Text = "Zgjidh tavolinën e re:", AutoSize = true, Location = new Point(18, 16), Font = new Font("Segoe UI", 12f, FontStyle.Bold) };
                combo.DropDownStyle = ComboBoxStyle.DropDownList; combo.Location = new Point(18, 48); combo.Size = new Size(394, 38); combo.Font = new Font("Segoe UI", 14f, FontStyle.Bold); combo.IntegralHeight = false; combo.DropDownHeight = 240;
                foreach (var t in tables) combo.Items.Add(new TableChoice(t.Key, t.Value));
                combo.DisplayMember = "Display"; combo.SelectedIndex = 0;
                ok.Text = "Transfero"; ok.DialogResult = DialogResult.OK; ok.Location = new Point(212, 112); ok.Size = new Size(96, 42); ok.Font = new Font("Segoe UI", 11f, FontStyle.Bold);
                cancel.Text = "Anulo"; cancel.DialogResult = DialogResult.Cancel; cancel.Location = new Point(316, 112); cancel.Size = new Size(96, 42); cancel.Font = new Font("Segoe UI", 11f, FontStyle.Bold);
                dialog.Controls.AddRange(new Control[] { label, combo, ok, cancel }); dialog.AcceptButton = ok; dialog.CancelButton = cancel;
                if (dialog.ShowDialog(this) != DialogResult.OK || combo.SelectedItem == null) return;
                int destinationTableId = ((TableChoice)combo.SelectedItem).Id;
                try
                {
                    using (SqlConnection con = DbConnection.GetConnection())
                    {
                        con.Open();
                        using (SqlTransaction tx = con.BeginTransaction())
                        {
                            using (SqlCommand check = new SqlCommand("SELECT COUNT(1) FROM Orders WHERE TableID=@id AND Status='Open'", con, tx))
                            {
                                check.Parameters.AddWithValue("@id", destinationTableId);
                                if (Convert.ToInt32(check.ExecuteScalar()) > 0) throw new InvalidOperationException("Tavolina e zgjedhur tashmë ka porosi të hapur.");
                            }
                            using (SqlCommand update = new SqlCommand("UPDATE Orders SET TableID=@newTable WHERE OrderID=@orderId AND TableID=@oldTable AND Status='Open'", con, tx))
                            {
                                update.Parameters.AddWithValue("@newTable", destinationTableId); update.Parameters.AddWithValue("@orderId", selectedOpenOrderId); update.Parameters.AddWithValue("@oldTable", selectedTableId);
                                if (update.ExecuteNonQuery() != 1) throw new InvalidOperationException("Porosia nuk u transferua. Rifresko dhe provo përsëri.");
                            }
                            using (SqlCommand updateStatus = new SqlCommand("UPDATE RestaurantTables SET Status = CASE WHEN TableID=@newTable THEN 'Occupied' WHEN TableID=@oldTable THEN 'Free' ELSE Status END WHERE TableID IN (@newTable,@oldTable)", con, tx))
                            {
                                updateStatus.Parameters.AddWithValue("@newTable", destinationTableId); updateStatus.Parameters.AddWithValue("@oldTable", selectedTableId); updateStatus.ExecuteNonQuery();
                            }
                            tx.Commit();
                        }
                    }
                    selectedTableId = destinationTableId;
                    UpdateOrderContextLabel();
                    MessageBox.Show("Porosia u transferua me sukses te tavolina " +
                        tables.Find(t => t.Key == destinationTableId).Value + ".",
                        "Transferimi", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    // Qëndrojmë në ekranin e porosisë; OrderID mbetet i njëjtë.
                    // Kur përdoruesi kthehet te tavolinat, statuset do të ringarkohen.
                    if (lblOrderContext != null)
                        lblOrderContext.BringToFront();
                }
                catch (Exception ex) { MessageBox.Show("Gabim gjatë transferimit:\n\n" + ex.Message, "Transferimi", MessageBoxButtons.OK, MessageBoxIcon.Error); }
            }
        }

